#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
ourokit="$(dirname "$root")/ourokit"
# mise.toml pins the prebuilt ouroctl; the sibling checkout must match it.
ourokit_revision="$(sed -n 's/.*"commit-\([0-9a-f]\{40\}\)".*/\1/p' "$root/mise.toml")"
[[ -n "$ourokit_revision" ]] || { echo 'mise.toml does not pin an Ourokit commit' >&2; exit 1; }
mise_version=v2026.9.18
export PATH="$HOME/.local/bin:$PATH"
SECONDS=0

echo 'Installing missing runtime and headless-test packages'
# build-essential compiles Ourokit's PAM test fixture in tests/native_session.py.
packages=(build-essential curl ca-certificates git python3
  python3-pil python3-gi gir1.2-glib-2.0 dbus-daemon lua5.4 sway grim wtype adwaita-icon-theme
  libfontconfig1 libfreetype6 libxkbcommon0)
missing=()
for package in "${packages[@]}"; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || :)" != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update -qq
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi

echo "Installing mise $mise_version and the prebuilt ouroctl"
[[ "$(uname -m)" == x86_64 ]] || { echo 'Ourokit publishes ouroctl for x86_64 Linux only' >&2; exit 1; }
if ! command -v mise >/dev/null || [[ "v$(mise --version | awk '{print $1}')" != "$mise_version" ]]; then
  curl --fail --silent --show-error --location --retry 3 --max-time 180 https://mise.run |
    MISE_VERSION="$mise_version" MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh
fi
mise trust --quiet "$root/mise.toml"
(cd "$root" && mise install --yes)
ouroctl="$(cd "$root" && mise which ouroctl)"

# Amp and supervised services start in separate non-interactive login shells.
if ! grep -Fqx '# Ouroshell orb toolchain' "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'PROFILE'

# Ouroshell orb toolchain
export PATH="$HOME/.local/bin:$PATH"
PROFILE
fi

echo 'Preparing the pinned sibling Ourokit checkout'
# Tests use its session peer and PAM fixture sources and expect the binary at
# zig-out/bin/ouroctl (ignored by Ourokit's git), so link the prebuilt one there.
if [[ ! -e "$ourokit" ]]; then
  git clone --quiet --no-checkout https://github.com/rockorager/ourokit.git "$ourokit"
  git -C "$ourokit" checkout --quiet --detach "$ourokit_revision"
elif [[ "$(git -C "$ourokit" rev-parse HEAD)" != "$ourokit_revision" ]] ||
     [[ -n "$(git -C "$ourokit" status --porcelain)" ]]; then
  echo "Preserving existing work in $ourokit; setup needs a clean checkout at $ourokit_revision" >&2
  exit 1
fi
mkdir -p "$ourokit/zig-out/bin"
ln -sfn "$ouroctl" "$ourokit/zig-out/bin/ouroctl"
"$ourokit/zig-out/bin/ouroctl" --help >/dev/null

echo 'Checking Ouroshell'
lua "$root/tests/bar.lua"
lua "$root/tests/launcher.lua"
echo "Orb setup ready in ${SECONDS}s; native tests: /usr/bin/python3 tests/native_launcher.py"
